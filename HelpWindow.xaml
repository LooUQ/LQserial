<Window x:Class="LQserial.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LQserial Help" Icon="LQserial.ico" Width="640" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#F3F7FC" Foreground="#1E2A3A"
        FontFamily="Aptos Narrow, Segoe UI" FontSize="14">
  <Window.Resources>
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#025EC7"/>
      <Setter Property="Margin" Value="0,16,0,4"/>
    </Style>
    <Style x:Key="P" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>
    <Style x:Key="B" TargetType="TextBlock" BasedOn="{StaticResource P}">
      <Setter Property="Margin" Value="14,1,0,1"/>
    </Style>
  </Window.Resources>
  <Border Margin="10" Padding="18,6,18,14" Background="White" BorderBrush="#808284" BorderThickness="1" CornerRadius="4">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="LQserial Help" FontSize="24" FontWeight="SemiBold" Foreground="#013A7A" Margin="0,8,0,0"/>
        <TextBlock Style="{StaticResource P}" Text="A serial terminal with a scriptable command list. Command list on the left, terminal on the right."/>

        <TextBlock Style="{StaticResource H}" Text="Getting connected"/>
        <TextBlock Style="{StaticResource B}" Text="1.  Pick the COM port, baud rate, stop bits, parity, byte size and flow control."/>
        <TextBlock Style="{StaticResource B}" Text="2.  Click Open Port. The button becomes Close Port and the settings are locked until you close."/>
        <TextBlock Style="{StaticResource B}" Text="3.  Type in Input String and click Send Command, or use the command list."/>
        <TextBlock Style="{StaticResource P}" Text="The port list refreshes each time you open the COM Port drop-down while the port is closed. The baud box accepts any rate you type."/>

        <TextBlock Style="{StaticResource H}" Text="Terminal pane"/>
        <TextBlock Style="{StaticResource P}" Text="The large pane shows everything sent and received, in order. Sent lines are prefixed with TX:."/>
        <TextBlock Style="{StaticResource B}" Text="•  Show Time — timestamps each received line and each TX line."/>
        <TextBlock Style="{StaticResource B}" Text="•  Show In HEX — shows received bytes as hex instead of text."/>
        <TextBlock Style="{StaticResource B}" Text="•  Clear Information — clears the terminal and event panes."/>
        <TextBlock Style="{StaticResource P}" Text="The pane keeps roughly the last 500,000 characters."/>

        <TextBlock Style="{StaticResource H}" Text="Event pane"/>
        <TextBlock Style="{StaticResource P}" Text="The small pane below the terminal logs events with a time: port opened (with its settings) or closed, open and write failures, files sent, scripts loaded or saved, and when a Run starts, stops or finishes."/>

        <TextBlock Style="{StaticResource H}" Text="Operation"/>
        <TextBlock Style="{StaticResource B}" Text="•  DTR / RTS — set the control lines. They apply immediately while the port is open and are used when you open it. RTS is managed by the driver when flow control is RTS/CTS."/>
        <TextBlock Style="{StaticResource B}" Text="•  Send With Enter — appends CR LF to Input String when sending."/>
        <TextBlock Style="{StaticResource B}" Text="•  HEX String — treats Input String as hex bytes, for example  AA 55 0D 0A  or  0xAA,0x55."/>
        <TextBlock Style="{StaticResource B}" Text="•  Select File / Send File — sends the raw bytes of a file to the port."/>
        <TextBlock Style="{StaticResource B}" Text="•  Save Log — when ticked, everything shown in the terminal pane is appended to the file named beside it. Use the Save Log button to choose the file."/>

        <TextBlock Style="{StaticResource H}" Text="Command list"/>
        <TextBlock Style="{StaticResource P}" Text="29 rows. Each row has:"/>
        <TextBlock Style="{StaticResource B}" Text="•  A checkbox that selects it for Run. Choose All Commands ticks them all."/>
        <TextBlock Style="{StaticResource B}" Text="•  The command text."/>
        <TextBlock Style="{StaticResource B}" Text="•  HEX — send this row as hex bytes."/>
        <TextBlock Style="{StaticResource B}" Text="•  Enter — append CR LF (on by default)."/>
        <TextBlock Style="{StaticResource B}" Text="•  A numbered button that sends just that row now."/>
        <TextBlock Style="{StaticResource B}" Text="•  Delay (mS) — pause after this row during a Run. Blank uses Delay Time."/>
        <TextBlock Style="{StaticResource P}" Text="Run sends every ticked, non-empty row in order, repeating the whole list Run Times times, then logs Run finished. Stop cancels it. Clear All Commands empties the list."/>

        <TextBlock Style="{StaticResource H}" Text="Scripts"/>
        <TextBlock Style="{StaticResource P}" Text="Load Test Script and Save As Script use the QCOM .ini format, so scripts are interchangeable with QCOM. A script holds all 29 rows, their HEX / Enter / Delay / tick settings, Run Times and Delay Time."/>
        <TextBlock Style="{StaticResource P}" Text="LQserial remembers the last script you loaded and opens it again at startup."/>

        <TextBlock Style="{StaticResource H}" Text="Mouse and keyboard tips"/>
        <TextBlock Style="{StaticResource B}" Text="•  Mouse wheel over a command field with long text scrolls that text sideways."/>
        <TextBlock Style="{StaticResource B}" Text="•  Mouse wheel anywhere else over the command list scrolls the list."/>
        <TextBlock Style="{StaticResource B}" Text="•  F1 opens this help."/>

        <TextBlock Style="{StaticResource H}" Text="Troubleshooting"/>
        <TextBlock Style="{StaticResource B}" Text="•  Cannot open port — another program may already be using it. Check the event pane for the exact message."/>
        <TextBlock Style="{StaticResource B}" Text="•  Port missing from the list — plug the device in, then reopen the COM Port drop-down."/>
        <TextBlock Style="{StaticResource B}" Text="•  No reply to AT commands — check the baud rate and that the device is powered and not in a different mode."/>
        <TextBlock Style="{StaticResource B}" Text="•  Garbled text — baud rate, parity or byte size doesn't match the device."/>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
