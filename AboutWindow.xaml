<Window x:Class="LQserial.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About LQserial" Icon="LQserial.ico" Width="520" Height="545" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F7FC" Foreground="#1E2A3A" FontFamily="Aptos Narrow, Segoe UI" FontSize="14">
  <Border Margin="10" Padding="18" Background="White" BorderBrush="#808284" BorderThickness="1" CornerRadius="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal">
        <Image Source="LooUQ-logo.png" Width="150" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="LQserial" FontSize="26" FontWeight="SemiBold" Foreground="#025EC7"/>
          <TextBlock x:Name="VersionText" Foreground="#5F6163"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,14,0,8">
        <TextBlock Text="Serial terminal with a scriptable command list." TextWrapping="Wrap"/>
        <TextBlock Text="Copyright © 2026 LooUQ Incorporated" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Text="Released as open source under the MIT License." Margin="0,2,0,0"/>
        <TextBlock Margin="0,2,0,0">
          <Run Text="Source code: "/>
          <Hyperlink NavigateUri="https://github.com/LooUQ/LQserial" RequestNavigate="Link_RequestNavigate" Foreground="#025EC7">https://github.com/LooUQ/LQserial</Hyperlink>
        </TextBlock>
      </StackPanel>

      <TextBox x:Name="LicenseBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto" BorderBrush="#B9BABB" Background="#ECEDED" Padding="6"/>

      <Button Grid.Row="3" Content="OK" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Width="80" Margin="0,12,0,0" Padding="8,4"
              Foreground="White" Background="#025EC7" BorderBrush="#014A9C"/>
    </Grid>
  </Border>
</Window>
